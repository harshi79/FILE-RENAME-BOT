# ── Required ──────────────────────────────────────────────────────────
API_ID=123456
API_HASH=your_api_hash
BOT_TOKEN=123456:ABC-DEF...
DATABASE_URL=postgresql://user:password@host:5432/dbname
ADMIN_IDS=111111111,222222222

# ── Optional (defaults shown are tuned for 512 MB RAM) ───────────────
MAX_FILE_SIZE_MB=25
MAX_GLOBAL_ACTIVE_JOBS=2
MAX_ACTIVE_JOBS_PER_USER=1
MAX_RETRIES=3
JOB_TIMEOUT=300
MAX_QUEUE_SIZE=20
# Render injects PORT automatically. HEALTH_PORT overrides it for local runs.
HEALTH_HOST=0.0.0.0
# HEALTH_PORT=8080
TEMP_DIR=/tmp/file-renamer
# Defaults to https://files.catbox.moe/5qz09e.mp4 if unset.
# START_VIDEO_URL=
RATE_LIMIT=60
